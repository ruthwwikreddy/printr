datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique // e.g., RX-1042
  customerPhone String?
  totalAmount   Float
  status        String      @default("CREATED") // CREATED, AWAITING_PAYMENT, PAID, QUEUED, PRINTING, COMPLETED, FAILED, CANCELLED
  files         OrderFile[]
  printJobs     PrintJob[]
  payments      Payment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderFile {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  filename  String
  filePath  String   // Local path
  mimeType  String
  fileSize  Int      // In bytes
  pageCount Int
  createdAt DateTime @default(now())
}

model PrintJob {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String         @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  
  // Settings
  copies      Int            @default(1)
  colourMode  String         @default("MONOCHROME") // MONOCHROME, COLOUR
  paperSize   String         @default("A4") // A4, A3
  duplexMode  String         @default("SIMPLEX") // SIMPLEX, DUPLEX
  pageRange   String?        // e.g., "1-5" or null for all
  
  printerName String?
  cupsJobId   String?
  errorLog    String?
  attempts    PrintAttempt[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PrintAttempt {
  id        String    @id @default(uuid())
  jobId     String
  job       PrintJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String
  errorMsg  String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
}

model Payment {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gatewayName      String   @default("Razorpay")
  gatewayOrderId   String   @unique
  gatewayPaymentId String?  @unique
  signature        String?
  amount           Float
  status           String   // created, captured, failed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PricingRule {
  id           String   @id @default(uuid())
  paperSize    String   // A4, A3
  colourMode   String   // MONOCHROME, COLOUR
  pricePerPage Float
  updatedAt    DateTime @updatedAt
}

model PrintAgent {
  id        String   @id @default(uuid())
  name      String
  tokenHash String   @unique
  isActive  Boolean  @default(true)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
}
